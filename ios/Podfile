# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

use_frameworks! :linkage => :static

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'ReactNativeDemo' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27's iOS Simulator SDK only supports deployment targets 15.0+; some
    # third-party pods (e.g. RNCAsyncStorage) still pin an older one. The
    # project-level pass covers targets that inherit the setting instead of
    # writing it per build config.
    installer.pods_project.build_configurations.each do |build_config|
      deployment_target = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if deployment_target.nil? || deployment_target.to_f < 15.0
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        deployment_target = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if deployment_target && deployment_target.to_f < 15.0
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        end
      end
    end

    # fmt 11.0.2 (pulled in by RN's RCT-Folly) hits a consteval regression under
    # Xcode 27's Clang; building it as C++17 disables the FMT_USE_CONSTEVAL path.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'fmt'
      target.build_configurations.each do |build_config|
        build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++17'
      end
    end

    # Modify RCT-Folly Portability.h to disable coroutines
    Dir.glob(installer.sandbox.root + "RCT-Folly/folly/Portability.h") do |file|
      begin
        # First try to make the file writable
        system "chmod +w #{file}"

        contents = File.read(file)
        modified_contents = contents.gsub(/#define FOLLY_HAS_COROUTINES 1/, '#define FOLLY_HAS_COROUTINES 0')

        # Try writing with elevated privileges if needed
        if !File.writable?(file)
          system "sudo chmod +w #{file}"
        end

        File.write(file, modified_contents)

        # Optionally restore original permissions
        system "chmod -w #{file}"
      rescue => e
        Pod::UI.warn "Failed to modify Portability.h: #{e.message}"
      end
    end
  end
end

target 'InsiderNotificationContent' do
  use_frameworks!
  inherit! :search_paths
  # Pods for InsiderNotificationContent
  # Exact pin: 2.4.0 is the version this port was built and verified against. The SDK's current
  # source already makes the InsiderPushNotification helpers this extension calls private and
  # renames iCarousel, and nothing here settles whether that ships as a patch or a minor — so a
  # range would be a guess. ios/Podfile.lock is gitignored, which makes this the only reproducible
  # resolution every developer and integrator gets. See MOB-26644 review.
  pod "InsiderMobileAdvancedNotification", "2.4.0"
end

target 'InsiderNotificationService' do
  use_frameworks!
  inherit! :search_paths
  # Pods for InsiderNotificationService
  # Exact pin: 2.4.0 is the version this port was built and verified against. The SDK's current
  # source already makes the InsiderPushNotification helpers this extension calls private and
  # renames iCarousel, and nothing here settles whether that ships as a patch or a minor — so a
  # range would be a guess. ios/Podfile.lock is gitignored, which makes this the only reproducible
  # resolution every developer and integrator gets. See MOB-26644 review.
  pod "InsiderMobileAdvancedNotification", "2.4.0"
end
